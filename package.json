{
  "name": "@duet3d/objectmodel",
  "version": "3.7.0-beta.1",
  "description": "TypeScript implementation of the Duet3D Object Model",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./deprecations.json": "./dist/deprecations.json",
    "./enums.json": "./dist/enums.json",
    "./documentation.json": "./dist/documentation.json"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "build": "tsc && tsx scripts/extract-metadata.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Duet3D/ObjectModel.git"
  },
  "author": "Christian Hammacher",
  "license": "LGPL-2.1",
  "bugs": {
    "url": "https://github.com/Duet3D/ObjectModel/issues"
  },
  "homepage": "https://github.com/Duet3D/ObjectModel#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "/dist"
  ]
}
