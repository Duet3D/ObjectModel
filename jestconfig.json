{
  "transform": {
    "^.+\\.(t|j)sx?$": ["@swc/jest", { "jsc": { "parser": { "syntax": "typescript" }, "target": "es2020" }, "module": { "type": "commonjs" } }]
  },
  "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
  "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
}
